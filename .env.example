# ── Provider ─────────────────────────────────────────────────
# Switch between: anthropic | openai | gemini
PROVIDER=anthropic

# ── API Keys (only the one matching PROVIDER is needed) ───────
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here
GEMINI_API_KEY=your_gemini_key_here

# ── Behaviour ────────────────────────────────────────────────
# Max coder→reviewer loops before force-stopping (default: 3)
MAX_ITERATIONS=3
# Shell command timeout in ms (default: 30000)
SHELL_TIMEOUT=30000

# ── Model override (optional) ─────────────────────────────────
# Anthropic default : claude-sonnet-4-6
# OpenAI default    : gpt-4o
# Gemini default    : gemini-1.5-pro
# MODEL=claude-sonnet-4-6
